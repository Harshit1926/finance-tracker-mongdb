# ---------- Flask ----------
SECRET_KEY=change-this-to-a-random-secret-string

# ---------- MongoDB Atlas ----------
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGO_DB_NAME=finance_tracker

# ---------- SMTP (Gmail example - use an App Password) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=youraddress@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_NAME=Finance Tracker

# ---------- Creator (superadmin) - seeded manually, never via signup ----------
CREATOR_EMAIL=you@example.com
CREATOR_PASSWORD=set-a-strong-password
CREATOR_NAME=Harshit Malhotra

# ---------- Groq (FinanceAgent LLM reasoning) ----------
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# ---------- OTP ----------
OTP_VALIDITY_SECONDS=60
